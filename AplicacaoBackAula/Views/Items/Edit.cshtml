@model AplicacaoBackAula.Models.Item

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Item</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Iditem" />
            <div class="form-group">
                <label asp-for="Idcategoria" class="control-label"></label>
                <select asp-for="Idcategoria" class="form-control" asp-items="ViewBag.Idcategoria"></select>
                <span asp-validation-for="Idcategoria" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Item1" class="control-label"></label>
                <input asp-for="Item1" class="form-control" />
                <span asp-validation-for="Item1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DescricaoItem" class="control-label"></label>
                <input asp-for="DescricaoItem" class="form-control" />
                <span asp-validation-for="DescricaoItem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" class="form-control" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TipoItem" class="control-label"></label>
                <input asp-for="TipoItem" class="form-control" />
                <span asp-validation-for="TipoItem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AtivoProdutoServico" class="control-label"></label>
                <input asp-for="AtivoProdutoServico" class="form-control" />
                <span asp-validation-for="AtivoProdutoServico" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
