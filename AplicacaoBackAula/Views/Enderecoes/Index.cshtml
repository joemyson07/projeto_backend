@model IEnumerable<AplicacaoBackAula.Models.Endereco>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cep)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Numero)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Complemento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdpessoaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cep)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Numero)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Complemento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdpessoaNavigation.Idpessoa)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Idendereco">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Idendereco">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Idendereco">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
